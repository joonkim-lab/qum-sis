rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // 플랫폼 소유자(에듀클레시아) — 모든 학교에 접근
    function isOwner() { return signedIn() && email() == 'joon.kim@educclesia.com'; }
    function member() { return get(/databases/$(db)/documents/memberships/$(email())).data; }
    function inSchool(sid) { return signedIn() && exists(/databases/$(db)/documents/memberships/$(email())) && member().schoolId == sid; }
    function role(sid) { return inSchool(sid) ? member().role : ''; }
    function isManager(sid) { return isOwner() || role(sid) in ['admin','principal','academic']; }   // academic = 학사(교무·카운슬러·헤드티처)
    function isPrincipal(sid) { return isOwner() || role(sid) == 'principal'; }
    function isStaff(sid) { return isManager(sid) || role(sid) == 'teacher'; }
    function isSelf(sid, studentId) { return role(sid) == 'student' && member().studentId == studentId; }
    // 교사 권한 담임: memberships.house = 담임반 ID → 그 반 학생만
    function inMyHouse(sid, studentId) { return role(sid) == 'teacher' && member().get('house', null) != null
      && studentId in get(/databases/$(db)/documents/schools/$(sid)/sections/$(member().house)).data.get('studentIds', []); }
    // 교사 열람 범위: scopes/{email}.studentIds = 담임반 + 맡은 과목 수강생 (학사·행정이 앱에서 계산)
    function inScope(sid, studentId) { return role(sid) == 'teacher'
      && studentId in get(/databases/$(db)/documents/schools/$(sid)/scopes/$(email())).data.get('studentIds', []); }
    function canSee(sid, studentId) { return isManager(sid) || inScope(sid, studentId); }

    // 멤버십: 본인 것은 읽기, 쓰기는 소유자·교장
    match /memberships/{em} {
      allow read: if signedIn() && (em == email() || isOwner() || resource.data.schoolId != null && isPrincipal(resource.data.schoolId));
      allow write: if isOwner() || (request.resource.data.schoolId != null && isPrincipal(request.resource.data.schoolId));
      // 학사·행정은 담임반 연결(house)만 바꿀 수 있음
      allow update: if resource.data.schoolId != null && isManager(resource.data.schoolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['house']);
    }

    match /schools/{sid} {
      allow read: if inSchool(sid) || isOwner();
      allow create: if isOwner();
      allow update: if isPrincipal(sid);

      match /students/{id} {
        allow read: if canSee(sid, id) || isSelf(sid, id);
        allow create, delete: if isManager(sid);
        allow update: if isManager(sid) || (isSelf(sid, id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['needsReview','reviewedBy','reviewedAt']));   // 학생은 '확인'만, 수정은 requests로
      }
      match /accounts/{id} {           // 로그인 ID 등 — 행정 전용
        allow read, write: if isManager(sid);
      }
      match /courses/{id} {
        allow read: if isStaff(sid) || role(sid) == 'student';
        allow write: if isManager(sid);
      }
      match /grades/{id} {
        allow read: if canSee(sid, resource.data.studentId) || isSelf(sid, resource.data.studentId);
        allow create: if canSee(sid, request.resource.data.studentId);
        allow update: if canSee(sid, resource.data.studentId) && canSee(sid, request.resource.data.studentId);
        allow delete: if canSee(sid, resource.data.studentId);
      }
      match /attendance/{id} {         // 입력은 출결 원본 시트(동기화) — 앱은 보기 전용
        allow read: if canSee(sid, resource.data.studentId) || isSelf(sid, resource.data.studentId);
        allow write: if isManager(sid);
      }
      match /activities/{id} {         // 수상·시험·활동·봉사 — 학생 본인 입력, 행정 승인
        allow read: if canSee(sid, resource.data.studentId) || isSelf(sid, resource.data.studentId);
        allow create: if canSee(sid, request.resource.data.studentId) || isSelf(sid, request.resource.data.studentId);
        allow update, delete: if isManager(sid) || (isSelf(sid, resource.data.studentId) && resource.data.approved != true);
      }
      match /incidents/{id} {          // 징계·사건 기록 — 읽기 학사·행정·교장 + 담임(자기 반 학생만), 추가 학사·행정·교장, 수정·삭제 교장만
        allow read: if isManager(sid) || inMyHouse(sid, resource.data.studentId);
        allow create: if isManager(sid);
        allow update, delete: if isPrincipal(sid);
      }
      match /comments/{id} {           // 세특·교사 코멘트·월간 담임 의견 (studentId "__common" = 과목·학년 공통 문단)
        allow read: if isManager(sid) || (isStaff(sid) && (resource.data.studentId == '__common' || inScope(sid, resource.data.studentId)));
        allow create: if isManager(sid) || (isStaff(sid) && (request.resource.data.studentId == '__common' || inScope(sid, request.resource.data.studentId)));
        allow update: if isManager(sid) || (isStaff(sid) && request.resource.data.studentId == resource.data.studentId
          && (resource.data.studentId == '__common' || inScope(sid, resource.data.studentId)));
        allow delete: if isManager(sid) || (isStaff(sid) && (resource.data.studentId == '__common' || inScope(sid, resource.data.studentId)));
      }
      match /scopes/{em} {             // 교사 열람 범위 — 본인 것 읽기, 계산·저장은 학사·행정·교장
        allow read: if isManager(sid) || (isStaff(sid) && em == email());
        allow write: if isManager(sid);
      }
      match /mentors/{id} {            // 과목 담당 교사(On-Site Mentor) — 학기마다 이어받음
        allow read: if isStaff(sid);
        allow write: if isManager(sid);
      }
      match /sections/{id} {           // 반(담임반·과목반) — 교직원 편집, 학생은 보기
        allow read: if isStaff(sid) || role(sid) == 'student';
        allow write: if isStaff(sid);
      }
      match /progress/{id} {           // 과목별 진도 상태 — 교사 입력(범위 안 학생), 학생 본인 열람
        allow read: if canSee(sid, resource.data.studentId) || isSelf(sid, resource.data.studentId);
        allow create, update: if canSee(sid, request.resource.data.studentId);
        allow delete: if canSee(sid, resource.data.studentId);
      }
      match /biweekly/{id} {           // 격주 출결 확인서 담임 의견
        allow read, write: if isStaff(sid);
      }
      match /requests/{id} {           // 학생 수정 요청
        allow read: if isManager(sid) || isSelf(sid, resource.data.studentId);
        allow create: if isSelf(sid, request.resource.data.studentId);
        allow update, delete: if isManager(sid);
      }
      match /audit/{id} {              // 변경 이력 — 본인 이름으로 추가만, 열람은 교장, 수정·삭제 불가
        allow read: if isPrincipal(sid);
        allow create: if (inSchool(sid) || isOwner()) && request.resource.data.by == email();
        allow update, delete: if false;
      }
      match /payments/{id} {
        allow read, write: if isManager(sid);
      }
      match /calendar/{id} {
        allow read: if inSchool(sid) || isOwner();
        allow write: if isManager(sid);
      }
    }
  }
}
